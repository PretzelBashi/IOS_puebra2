#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["changoVueltas", "changoAnimacion"]
    def "chango" (
        active = true
        customData = {
            float3 rotationEulerHint = (4.712388, 3.1415927, 0)
        }
        references = @chango.usdc@
    )
    {
        quatf xformOp:orient = (-3.090861e-8, 3.0908627e-8, 0.7071066, 0.70710695)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (-0.0030148448, 1.1920929e-7, 0.0047357082)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = </Root/chango/OnAddedToScene>
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnAddedToScene"
        {
            rel actions = </Root/chango/OnAddedToScene/Action>
            uniform bool exclusive
            rel triggers = </Root/chango/OnAddedToScene/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/chango>
                token info:id = "SceneTransition"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/changoAnimacion>
                rel animationLibraryKeyOverrideKey = </Root/chango/OnAddedToScene/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }
    }

    def RealityKitTimeline "changoVueltas"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Spin"
            {
                string actionKind = "spin"
                int blendLayer = 400
                double duration = 3.0074251418757467
                uniform token info:id = "223C5F30-C4FF-4F10-BC61-5909EA85534E"
                float3 localAxis = (0, 0, 1)
                double startTime = 0
                rel target = </Root/chango>

                def RealityKitStruct "timingFunction"
                {
                    token type = "linear"
                }
            }
        }
    }

    def RealityKitTimeline "changoAnimacion"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Play_Timeline"
            {
                string actionKind = "timeline"
                int blendLayer = 500
                double duration = 3.0074251418757467
                uniform token info:id = "71D82951-BCC6-494C-8B70-CF419583C271"
                double loopCount = 0
                double startTime = 0
                rel timeline = </Root/changoVueltas>
            }
        }
    }
}

